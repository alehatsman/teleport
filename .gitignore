# Rust
/daemon/target/
/spike/target/
/cli/target/

# Dev daemon data (docs/09-frontend.md#dev-workflow) -- holds the auth token
/.dev-data/

# Web
/web/node_modules/
/web/dist/
/web/dist-ssr/
*.local

# Playwright e2e (docs/10-testing.md#web-e2e-playwright)
/web/e2e/.tmp/
/web/playwright-report/
/web/test-results/
/web/blob-report/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store

# `provision apply tasks/findings.yml` writes one per crate. A build artifact
# for agents to read, never committed.
.gate/

# `codeintel index .` writes a local symbol index here -- segments and
# dictionaries, ~1.3 MB. Machine-specific and rebuilt on demand, so it is
# the same kind of thing as `.gate/` above: read by agents, never committed.
.codeintel/
