# ts-quality's supply-chain posture (tasks/ui-sync-config.yml prints this
# block; scripts/supply-chain.sh in the gate reports on it).
engine-strict=true
save-exact=true
# Days a version must have been published before npm will install it. npm's
# key, in DAYS (pnpm's is minimumReleaseAge, in minutes).
min-release-age=3
# Lifecycle scripts run only for packages listed under allow-scripts. None
# are listed: nothing in this tree has one (vite 8 bundles with rolldown, so
# there is no esbuild postinstall to allow).
strict-allow-scripts=true
