{
  // Later entries win, so the ts-quality baseline sits last and cannot be
  // weakened by the svelte preset.
  "extends": ["@tsconfig/svelte/tsconfig.json", "./tsconfig.base.json"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "module": "esnext",
    "types": ["svelte", "vite/client"],
    "allowArbitraryExtensions": true,
    "noEmit": true,
    // "@/..." resolves to src/... -- matching vite.config.ts resolve.alias.
    // Keeps imports flat and move-proof (codefort's web app does the same).
    // `baseUrl` is required for non-relative `paths` entries pre-TS 7;
    // `ignoreDeprecations` silences 6.0's warning about its eventual
    // removal (https://aka.ms/ts6) until this project moves to TS 7's
    // replacement (an import map, per that migration guide).
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "moduleDetection": "force"
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.svelte"]
}
