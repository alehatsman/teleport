{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings --max-diagnostics=none .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "allowScripts": {
    "fsevents": false
  }
}
