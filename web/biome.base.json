{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": false },

  "files": {
    "includes": [
      "!**/node_modules",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/.gate",
      "!**/*.min.js",
      "!**/*.gen.ts"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "double",
      "trailingCommas": "es5"
    }
  },

  "assist": {
    "enabled": true,
    "actions": { "source": { "organizeImports": "on" } }
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "correctness": {
        "noUndeclaredDependencies": "error",
        "noUnresolvedImports": "error"
      },

      "suspicious": {
        "noConsole": { "level": "error", "options": { "allow": ["error", "warn"] } },
        "noConstantBinaryExpressions": "error",
        "noEmptyBlockStatements": "warn",
        "noVar": "error",
        "noShadow": "warn",
        "noImportCycles": "warn",
        "noUnnecessaryConditions": "warn",
        "useArraySortCompare": "error",
        "noSkippedTests": "warn"
      },

      "security": {
        "noSecrets": "warn"
      },

      "performance": {
        "noBarrelFile": "warn",
        "noReExportAll": "warn",
        "noNamespaceImport": "warn",
        "noDelete": "error"
      },

      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        }
      },

      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useAwaitThenable": "error",
        "noBaseToString": "warn",
        "noUnsafePlusOperands": "error"
      }
    }
  }
}
